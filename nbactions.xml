<?xml version="1.0" encoding="UTF-8"?>
<actions>
    <action>
        <actionName>run</actionName>
        <packagings>
            <packaging>jar</packaging>
        </packagings>
        <restartable>true</restartable>
        <goals>
            <goal>process-classes</goal>
            <goal>org.springframework.boot:spring-boot-maven-plugin:run</goal>
        </goals>
        <properties>
            <run.jvmArguments></run.jvmArguments>
            <run.mainClass>com.glasscore.GlassCoreApplication</run.mainClass>
            <Env.SPRING_OUTPUT_ANSI_ENABLED>ALWAYS</Env.SPRING_OUTPUT_ANSI_ENABLED>
            <Env.SPRING_BOOT_RUN_FORK>false</Env.SPRING_BOOT_RUN_FORK>
        </properties>
    </action>
    <action>
        <actionName>debug</actionName>
        <packagings>
            <packaging>jar</packaging>
        </packagings>
        <restartable>true</restartable>
        <goals>
            <goal>process-classes</goal>
            <goal>org.springframework.boot:spring-boot-maven-plugin:run</goal>
        </goals>
        <properties>
            <run.jvmArguments>-agentlib:jdwp=transport=dt_socket,server=n,address=${jpda.address}</run.jvmArguments>
            <run.mainClass>com.glasscore.GlassCoreApplication</run.mainClass>
            <jpda.listen>true</jpda.listen>
            <Env.SPRING_OUTPUT_ANSI_ENABLED>ALWAYS</Env.SPRING_OUTPUT_ANSI_ENABLED>
            <Env.SPRING_BOOT_RUN_FORK>false</Env.SPRING_BOOT_RUN_FORK>
        </properties>
    </action>
    <action>
        <actionName>profile</actionName>
        <packagings>
            <packaging>jar</packaging>
        </packagings>
        <goals>
            <goal>process-classes</goal>
            <goal>org.springframework.boot:spring-boot-maven-plugin:run</goal>
        </goals>
        <properties>
            <run.jvmArguments>${profiler.jvmargs.argline}</run.jvmArguments>
            <run.mainClass>com.glasscore.GlassCoreApplication</run.mainClass>
        </properties>
    </action>
</actions>
